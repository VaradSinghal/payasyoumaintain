{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paymu.com/schemas/dtc-reading.schema.json/v1.1.0",
  "title": "DtcReading",
  "description": "A reading of Diagnostic Trouble Codes (DTC) from a vehicle.",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the vehicle."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the reading was taken."
    },
    "confirmed_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[PBCU][01][0-9A-F]{3}$"
      },
      "description": "List of Mode 03 stored/confirmed Diagnostic Trouble Codes."
    },
    "pending_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[PBCU][01][0-9A-F]{3}$"
      },
      "description": "List of Mode 07 pending Diagnostic Trouble Codes."
    },
    "source": {
      "type": "string",
      "enum": [
        "obd_device",
        "manual_entry"
      ],
      "description": "The source of the DTC reading."
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID of the OBD device, if source is obd_device. Null otherwise."
    }
  },
  "required": [
    "vehicle_id",
    "timestamp",
    "confirmed_codes",
    "pending_codes",
    "source"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "source": { "const": "obd_device" } }
      },
      "then": {
        "properties": { "device_id": { "type": "string" } },
        "required": ["device_id"]
      }
    },
    {
      "if": {
        "properties": { "source": { "const": "manual_entry" } }
      },
      "then": {
        "properties": { "device_id": { "type": "null" } }
      }
    }
  ],
  "additionalProperties": false
}
