{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payasyoumaintain.com/schemas/error-response/v1.0.0",
  "title": "Error Response",
  "description": "Standard error payload returned by all Pay As You Maintain services on 4xx/5xx responses.",
  "type": "object",
  "required": [
    "error",
    "message",
    "timestamp"
  ],
  "properties": {
    "error": {
      "type": "string",
      "description": "Machine-readable error code."
    },
    "message": {
      "type": "string",
      "description": "Human-readable description of the error."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the error occurred."
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of granular validation or field-level error messages."
    }
  },
  "additionalProperties": false
}
